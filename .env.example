OPENROUTER_API_KEY=sk-or-v1-xxx
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
DEEPSEEK_API_KEY=sk-xxx
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional. Override the simulation generator model. Defaults to
# Dolphin-Mistral 24B Venice (uncensored, free tier on OpenRouter).
# For production, set the paid lane to avoid rate limits:
# OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition
OPENROUTER_MODEL=

# Optional. HuggingFace token for the CardiffNLP sentiment + offensive
# classifiers used to score generated messages. Without it the classifier
# falls back to the free public Inference API (rate-limited, slower
# cold-starts) and gracefully falls back to the round target sentiment
# on any failure. Get one at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
